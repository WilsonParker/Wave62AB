{
  "manifest_version": 3,
  "name": "ALMA/BICO Assistant",
  "version": "1.0.0",
  "description": "INDITEX ALMA FESHLL 언어 자동 설정 + BICO 주문 보조 도구(Cases 통계)",
  "permissions": [
    "storage",
    "scripting",
    "cookies"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ALMA/BICO 설정"
  },
  "host_permissions": [
    "https://apps.inditex.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://apps.inditex.com/almafeshll/*"
      ],
      "js": [
        "src/alma.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://apps.inditex.com/bico/*"
      ],
      "js": [
        "src/bico.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/interceptor.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
